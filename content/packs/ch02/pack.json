        "steps": [
          {
            "step_id": "step.echo_patrol_offer",
            "speaker": "npc.ch02.fog_keeper",
            "line": "解析できた。記憶片には旧砦へ向かう残響騎士の記録が残っている。巡回隊を追って道を確保して。",
