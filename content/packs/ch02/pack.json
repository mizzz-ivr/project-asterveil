                ]
              },
              {
                "choice_id": "choice.first_trace_later",
                "text": "準備してから受ける",
                "next_step_id": "step.first_trace_later",
                "effects": [
                  {
                    "action_type": "end_dialogue",
                    "params": {}
                  }
                ]
              }
            ]
          },
          {
            "step_id": "step.first_trace_after_accept",
            "speaker": "npc.ch02.fog_keeper",
            "line": "依頼状況を確認して、受注できていれば霧渡り湿原へ。霧狼の動きを見逃さないで。"
          },
          {
            "step_id": "step.first_trace_later",
            "speaker": "npc.ch02.fog_keeper",
            "line": "了解。霧は待ってくれないけれど、無理な出発はもっと危険よ。"
          }
        ]
      },
      {
