        "steps": [
          {
            "step_id": "step.first_trace_offer",
            "speaker": "npc.ch02.fog_keeper",
            "line": "霧港へようこそ。まず湿原の霧狼を追い、霧の濃まり方を確かめてほしい。",
            "choices": [
              {
                "choice_id": "choice.first_trace_accept",
